    "typography": {
      "fontFamily": {
        "primary": "'Inter', 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "mono": "'JetBrains Mono', 'Fira Code', 'Courier New', monospace",
        "comment": "Inter is the reference design's closest match. System fonts as fallback."
      },
      "scale": {
        "h1": {
          "size": "24px",
          "weight": "600",
          "lineHeight": "1.3",
          "letterSpacing": "-0.02em",
          "usage": "Page title (e.g. 'Contract', 'Clients')"
        },
        "h2": {
          "size": "18px",
          "weight": "600",
          "lineHeight": "1.4",
          "letterSpacing": "-0.01em",
          "usage": "Section titles inside detail pages (e.g. 'Contract Information', 'Team Assignments')"
        },
        "h3": {
          "size": "15px",
          "weight": "600",
          "lineHeight": "1.4",
          "usage": "Card titles, KPI card labels"
        },
        "subtitle": {
          "size": "13px",
          "weight": "400",
          "lineHeight": "1.5",
          "color": "text.secondary",
          "usage": "Supporting text under KPI numbers, helper text in forms"
        },
        "body": {
          "size": "14px",
          "weight": "400",
          "lineHeight": "1.6",
          "usage": "Table cell content, form inputs, body text"
        },
        "bodySmall": {
          "size": "13px",
          "weight": "400",
          "lineHeight": "1.5",
          "usage": "Secondary table data, metadata, timestamps"
        },
        "label": {
          "size": "12px",
          "weight": "500",
          "lineHeight": "1",
          "letterSpacing": "0.01em",
          "usage": "Status badges, column headers, filter labels"
        },
        "kpiNumber": {
          "size": "36px",
          "weight": "700",
          "lineHeight": "1.1",
          "letterSpacing": "-0.03em",
          "usage": "The large counter number inside KPI cards"
        },
        "navItem": {
          "size": "13px",
          "weight": "500",
          "lineHeight": "1",
          "usage": "Sidebar navigation items"
        }
      }
    },
  
    "borders": {
      "radius": {
        "xs": "4px",
        "sm": "6px",
        "md": "8px",
        "lg": "12px",
        "xl": "16px",
        "pill": "9999px",
        "usageGuide": {
          "badges": "pill",
          "buttons": "md",
          "cards": "lg",
          "inputs": "md",
          "dropdowns": "lg",
          "modals": "xl",
          "tableRows": "0"
        }
      },
      "width": {
        "default": "1px",
        "subtle": "0.5px"
      },
      "color": {
        "default": "#E4E4E8",
        "subtle": "#F0F0F2"
      },
      "shadows": {
        "card": "0 1px 3px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04)",
        "dropdown": "0 8px 24px rgba(0, 0, 0, 0.10), 0 2px 6px rgba(0, 0, 0, 0.06)",
        "modal": "0 20px 48px rgba(0, 0, 0, 0.12), 0 4px 12px rgba(0, 0, 0, 0.08)",
        "tableHover": "none",
        "sidebarItem": "none",
        "comment": "Shadows are deliberately subtle. The most prominent shadow is reserved for modals and dropdowns only."
      }
    },
  
