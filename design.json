{
    "meta": {
      "project": "Nexus",
      "version": "1.0.0",
      "reference": "Tiimi – Contract Dashboard (Dribbble)",
      "author": "Design Engineering",
      "date": "2026-04-17"
    },
  
    "designPrinciples": {
      "vibe": "Enterprise-grade yet approachable. A serious B2B SaaS tool that respects the user's intelligence — data-dense without feeling cramped, professional without being cold.",
      "principles": [
        "Clarity first: every pixel earns its place. No decoration that doesn't carry information.",
        "Structured hierarchy: the eye always knows where to go next — page title → KPI summary → data table → actions.",
        "Subtle depth: the UI uses only two elevation levels — flat surface (sidebar/content) and floating layer (cards, modals, dropdowns). No heavy shadows.",
        "Restrained color: chromatic color is reserved for status signals and CTAs only. Everything else lives in a neutral gray scale.",
        "Confident whitespace: generous internal padding inside cards and rows creates breathing room in high-density views."
      ]
    },
  
    "colors": {
      "primary": {
        "brand": "#F0C14B",
        "brandDark": "#D4A72C",
        "comment": "Golden yellow used for the logo mark and the primary CTA button background."
      },
      "cta": {
        "actionBg": "#1A1A2E",
        "actionBgHover": "#12122A",
        "actionText": "#FFFFFF",
        "comment": "Dark navy used as the primary action button (Create Contract). Text is pure white."
      },
      "neutral": {
        "white": "#FFFFFF",
        "gray50": "#F7F7F8",
        "gray100": "#F0F0F2",
        "gray200": "#E4E4E8",
        "gray300": "#CBCBD1",
        "gray400": "#9898A3",
        "gray500": "#6B6B78",
        "gray700": "#3A3A47",
        "gray900": "#1A1A2E"
      },
      "backgrounds": {
        "page": "#F7F7F8",
        "sidebar": "#1A1A2E",
        "sidebarDark": "#12122A",
