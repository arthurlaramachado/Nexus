      },
      "status": {
        "activeBackground": "#DCFCE7",
        "activeText": "#15803D",
        "activeDot": "#22C55E",
        "nearExpireBackground": "#FEF9C3",
        "nearExpireText": "#854D0E",
        "expiredBackground": "#FEE2E2",
        "expiredText": "#991B1B",
        "draftBackground": "#E0E7FF",
        "draftText": "#3730A3",
        "endedBackground": "#F1F1F4",
        "endedText": "#6B6B78"
